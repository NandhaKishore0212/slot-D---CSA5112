
#include <stdio.h>
#include <string.h>

int main() {
    char text[1000],freq[]="ETAOINSHRDLCUMWFGYPBVKJXQZ";
    int count[26]={0},used[26]={0};
    int map[26];

    printf("Enter ciphertext: ");
    fgets(text,sizeof(text),stdin);

    for(int i=0;text[i];i++)
        if(text[i]>='A' && text[i]<='Z')
            count[text[i]-'A']++;

    for(int i=0;i<26;i++) map[i]=-1;

    for(int i=0;i<26;i++) {
        int max=-1,pos=-1;

        for(int j=0;j<26;j++) {
            if(!used[j] && count[j]>max) {
                max=count[j];
                pos=j;
            }
        }

        if(pos>=0) {
            used[pos]=1;
            map[pos]=freq[i]-'A';
        }
    }

    printf("\nPossible plaintext:\n");

    for(int i=0;text[i];i++) {
        if(text[i]>='A' && text[i]<='Z')
            printf("%c",map[text[i]-'A']+'A');
        else if(text[i]>='a' && text[i]<='z')
            printf("%c",map[text[i]-'a']+'a');
        else
            putchar(text[i]);
    }

    return 0;
}
