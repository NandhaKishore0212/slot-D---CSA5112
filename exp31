
#include <stdio.h>
#include <stdint.h>

uint64_t leftShift64(uint64_t x) {
    return x << 1;
}

int main() {
    uint64_t L,K1,K2;

    printf("Enter 64-bit value in hexadecimal: ");
    scanf("%llx",(unsigned long long*)&L);

    K1=leftShift64(L);

    if(L & 0x8000000000000000ULL)
        K1 ^= 0x1B;

    K2=leftShift64(K1);

    if(K1 & 0x8000000000000000ULL)
        K2 ^= 0x1B;

    printf("K1 = %016llX\n",(unsigned long long)K1);
    printf("K2 = %016llX\n",(unsigned long long)K2);

    return 0;
}
