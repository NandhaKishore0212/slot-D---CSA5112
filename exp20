
#include <stdio.h>
#include <stdint.h>

int main(void) {
    uint8_t original[4] = {0x10, 0x20, 0x30, 0x40};
    uint8_t ecb[4], cbc[4];

    for (int i = 0; i < 4; i++) {
        ecb[i] = original[i];
        cbc[i] = original[i];
    }

    // Simulate a transmission bit error in C1.
    ecb[0] ^= 0x01;
    cbc[0] ^= 0x01;

    printf("ECB: ");
    for (int i = 0; i < 4; i++)
        printf("%02X ", ecb[i]);
    printf("\n");

    printf("CBC ciphertext after C1 error: ");
    for (int i = 0; i < 4; i++)
        printf("%02X ", cbc[i]);
    printf("\n");

    printf("\nExpected decryption behavior:\n");
    printf("ECB: only P1 is corrupted.\n");
    printf("CBC: P1 is corrupted; corresponding bit in P2 flips.\n");
    printf("CBC: P3 and later plaintext blocks are unchanged.\n");

    return 0;
}
