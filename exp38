
#include <stdio.h>

int mod(int x) {
    return (x%26+26)%26;
}

int inverse(int x) {
    for(int i=1;i<26;i++)
        if(mod(x*i)==1) return i;
    return -1;
}

int main() {
    int p[2][2],c[2][2];
    int det,inv;
    int pi[2][2],key[2][2];

    printf("Enter plaintext matrix (2x2):\n");
    for(int i=0;i<2;i++)
        for(int j=0;j<2;j++)
            scanf("%d",&p[i][j]);

    printf("Enter ciphertext matrix (2x2):\n");
    for(int i=0;i<2;i++)
        for(int j=0;j<2;j++)
            scanf("%d",&c[i][j]);

    det=mod(p[0][0]*p[1][1]-p[0][1]*p[1][0]);
    inv=inverse(det);

    if(inv==-1) {
        printf("Plaintext matrix is not invertible\n");
        return 1;
    }

    pi[0][0]=mod(p[1][1]*inv);
    pi[0][1]=mod(-p[0][1]*inv);
    pi[1][0]=mod(-p[1][0]*inv);
    pi[1][1]=mod(p[0][0]*inv);

    for(int i=0;i<2;i++)
        for(int j=0;j<2;j++) {
            key[i][j]=0;
            for(int k=0;k<2;k++)
                key[i][j]+=c[i][k]*pi[k][j];

            key[i][j]=mod(key[i][j]);
        }

    printf("Recovered Hill key:\n");

    for(int i=0;i<2;i++) {
        for(int j=0;j<2;j++)
            printf("%d ",key[i][j]);
        printf("\n");
    }

    return 0;
}
