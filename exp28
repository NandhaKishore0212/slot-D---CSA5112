
#include <stdio.h>

long long power(long long a,long long b,long long q) {
    long long r=1;
    while(b>0) {
        if(b%2) r=(r*a)%q;
        a=(a*a)%q;
        b/=2;
    }
    return r;
}

int main() {
    long long q,a,x,y,A,B,k1,k2;

    printf("Enter prime q: ");
    scanf("%lld",&q);

    printf("Enter public base a: ");
    scanf("%lld",&a);

    printf("Enter Alice secret: ");
    scanf("%lld",&x);

    printf("Enter Bob secret: ");
    scanf("%lld",&y);

    A=power(a,x,q);
    B=power(a,y,q);

    k1=power(B,x,q);
    k2=power(A,y,q);

    printf("Alice sends: %lld\n",A);
    printf("Bob sends: %lld\n",B);
    printf("Alice shared key: %lld\n",k1);
    printf("Bob shared key: %lld\n",k2);

    if(k1==k2)
        printf("Key exchange successful\n");

    return 0;
}
