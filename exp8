
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char plain[200];
    char key[] = "CIPHERABDFGJKLMNOQSTUVWXYZ";
    char alphabet[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    int i, pos;

    printf("Enter plaintext: ");
    fgets(plain, sizeof(plain), stdin);

    printf("Cipher alphabet: %s\n", key);
    printf("Encrypted text: ");

    for (i = 0; plain[i] != '\0'; i++) {
        if (isupper((unsigned char)plain[i])) {
            pos = plain[i] - 'A';
            printf("%c", key[pos]);
        } else if (islower((unsigned char)plain[i])) {
            pos = plain[i] - 'a';
            printf("%c", tolower(key[pos]));
        } else {
            printf("%c", plain[i]);
        }
    }

    printf("\n");
    return 0;
}
