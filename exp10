
#include <stdio.h>
#include <string.h>
#include <ctype.h>

char matrix[5][5] = {
    {'M','F','H','I','K'},
    {'U','N','O','P','Q'},
    {'Z','V','W','X','Y'},
    {'E','L','A','R','G'},
    {'D','S','T','B','C'}
};

void findPosition(char ch, int *r, int *c) {
    int i, j;

    if (ch == 'J')
        ch = 'I';

    for (i = 0; i < 5; i++) {
        for (j = 0; j < 5; j++) {
            if (matrix[i][j] == ch) {
                *r = i;
                *c = j;
                return;
            }
        }
    }
}

int main() {
    char input[300], text[300], a, b;
    int i, n = 0, r1, c1, r2, c2;

    printf("Enter plaintext: ");
    getchar();  /* Consume any leftover newline */
    fgets(input, sizeof(input), stdin);

    for (i = 0; input[i] != '\0'; i++) {
        if (isalpha((unsigned char)input[i])) {
            char ch = toupper((unsigned char)input[i]);
            if (ch == 'J') ch = 'I';
            text[n++] = ch;
        }
    }
    text[n] = '\0';

    printf("Ciphertext: ");

    for (i = 0; i < n;) {
        a = text[i];

        if (i + 1 >= n) {
            b = 'X';
            i++;
        } else if (text[i] == text[i + 1]) {
            b = 'X';
            i++;
        } else {
            b = text[i + 1];
            i += 2;
        }

        findPosition(a, &r1, &c1);
        findPosition(b, &r2, &c2);

        if (r1 == r2) {
            printf("%c%c",
                matrix[r1][(c1 + 1) % 5],
                matrix[r2][(c2 + 1) % 5]);
        } else if (c1 == c2) {
            printf("%c%c",
                matrix[(r1 + 1) % 5][c1],
                matrix[(r2 + 1) % 5][c2]);
        } else {
            printf("%c%c",
                matrix[r1][c2],
                matrix[r2][c1]);
        }
    }

    printf("\n");
    return 0;
}
