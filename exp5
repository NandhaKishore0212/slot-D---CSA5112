5. Affine Caesar Cipher — C Program
The encryption formula is:

[ C = (ap+b)\mod26 ]

where:

p = plaintext value (A=0, B=1, ..., Z=25)
a = multiplication key
b = additive key
C = ciphertext value
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int gcd(int a, int b)
{
    while (b != 0)
    {
        int temp = b;
        b = a % b;
        a = temp;
    }

    return a;
}

int main()
{
    char plaintext[200], ciphertext[200];
    int a, b;

    printf("Enter plaintext: ");
    fgets(plaintext, sizeof(plaintext), stdin);
    plaintext[strcspn(plaintext, "\n")] = '\0';

    printf("Enter value of a: ");
    scanf("%d", &a);

    printf("Enter value of b: ");
    scanf("%d", &b);

    b = b % 26;
    if (b < 0)
        b += 26;

    if (gcd(a, 26) != 1)
    {
        printf("Invalid value of a.\n");
        printf("a must be relatively prime to 26.\n");
        return 1;
    }

    for (int i = 0; plaintext[i] != '\0'; i++)
    {
        if (isalpha(plaintext[i]))
        {
            int p = toupper(plaintext[i]) - 'A';
            int c = (a * p + b) % 26;

            ciphertext[i] = c + 'A';
        }
        else
        {
            ciphertext[i] = plaintext[i];
        }
    }

    ciphertext[strlen(plaintext)] = '\0';

    printf("Ciphertext: %s\n", ciphertext);

    return 0;
}
